# PostgreSQL settings for n8n internal DB & Chat Memory
POSTGRES_USER=n8n_user
POSTGRES_PASSWORD=change_me_strong_password_123
POSTGRES_DB=n8n_db

# n8n core settings
N8N_ENCRYPTION_KEY=super_secret_random_key_at_least_24_chars
GENERIC_TIMEZONE=UTC
TZ=UTC

# Vector DB & Gemini API key (https://aistudio.google.com/app/apikey); check current quota/pricing
QDRANT_URL=http://qdrant:6333
GEMINI_API_KEY=your_google_ai_studio_api_key

# Telegram & Google Sheets Logging IDs
ALERT_TELEGRAM_CHAT_ID=123456789
SUPPORT_TEAM_TELEGRAM_CHAT_ID=123456789
ERROR_LOG_SPREADSHEET_ID=your_google_sheet_id_here
